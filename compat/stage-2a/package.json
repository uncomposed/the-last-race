{
  "name": "the-last-race",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "A deterministic, belief-driven AI strategy game. Stage 2a local prototype.",
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "node scripts/identity.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test && npm run test:browser",
    "play": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "simulate": "tsx scripts/simulate.ts"
  },
  "dependencies": { "@modelcontextprotocol/sdk": "^1.25.0", "zod": "^3.25.0" },
  "devDependencies": { "@types/node": "^22.0.0", "esbuild": "^0.25.0", "playwright": "^1.55.0", "tsx": "^4.20.0", "typescript": "^5.9.0" }
}
