{
  "name": "the-last-race",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "description": "A deterministic, belief-driven AI lab strategy game. Connected lab prototype.",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "node scripts/identity.mjs && tsc",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "check": "npm run build && npm test && npm run test:browser",
    "play": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test:browser": "tsx scripts/browser-check.ts",
    "simulate": "tsx scripts/simulate.ts && tsx scripts/verify-campaign.ts",
    "play:legacy": "tsx compat/stage-2a/src/cli.ts",
    "verify:campaign": "tsx scripts/verify-campaign.ts",
    "play:stage-2b": "tsx compat/stage-2b/src/cli.ts",
    "play:lab": "tsx src/cli.ts --scenario lab-12",
    "verify:lab": "tsx scripts/verify-lab.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.25.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "esbuild": "^0.25.0",
    "playwright": "^1.55.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.0"
  }
}
